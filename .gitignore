# ─────────────────────────────────────────
# Node / npm
# ─────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/
.yarn/

# ─────────────────────────────────────────
# Vite
# ─────────────────────────────────────────
dist/
dist-ssr/
.vite/
*.local

# ─────────────────────────────────────────
# TypeScript
# ─────────────────────────────────────────
*.tsbuildinfo

# ─────────────────────────────────────────
# Rust / Cargo (src-tauri)
# ─────────────────────────────────────────
src-tauri/target/
src-tauri/gen/
src-tauri/release/
src-tauri/binaries/
src-tauri/bundle/
src-tauri/**/*.rs.bk
**/*.pdb

# ─────────────────────────────────────────
# Tauri bundle outputs
# ─────────────────────────────────────────
src-tauri/target/release/bundle/
src-tauri/target/debug/
.tauri
# ─────────────────────────────────────────
# Repo scanner submodule
# (source is tracked; built output is not)
# ─────────────────────────────────────────
lib/repo-scanner/dist/
lib/repo-scanner/node_modules/

# ─────────────────────────────────────────
# LSP servers
# (directories are tracked as empty stubs;
#  installed binaries and packages are not)
# ─────────────────────────────────────────
lib/lsp-servers/pyright/node_modules/
lib/lsp-servers/pyright/package.json
lib/lsp-servers/pyright/package-lock.json
lib/lsp-servers/pyright/pyright-langserver.js
lib/lsp-servers/typescript/node_modules/
lib/lsp-servers/typescript/package.json
lib/lsp-servers/typescript/package-lock.json
lib/lsp-servers/gopls/gopls
lib/lsp-servers/gopls/gopls.exe
lib/lsp-servers/rust-analyzer/rust-analyzer
lib/lsp-servers/rust-analyzer/rust-analyzer.exe
lib/lsp-servers/clangd/clangd
lib/lsp-servers/clangd/clangd.exe
lib/lsp-servers/clangd/bin/
lib/lsp-servers/clangd/lib/

# ─────────────────────────────────────────
# Browser automation tool (Playwright)
# ─────────────────────────────────────────
lib/browser-tool/node_modules/
lib/browser-tool/package-lock.json

# ─────────────────────────────────────────
# Test / coverage
# ─────────────────────────────────────────
coverage/
.nyc_output/

# ─────────────────────────────────────────
