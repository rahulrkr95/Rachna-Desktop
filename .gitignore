# ─────────────────────────────────────────
.embeddings/
.vector-db/
.chroma/
.lancedb/
.qdrant/
workspace/
sessions/

# ─────────────────────────────────────────
# SQLite databases (keychain / history)
# ─────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─────────────────────────────────────────
# Logs
# ─────────────────────────────────────────
logs/
*.log

# ─────────────────────────────────────────
# Cache / temp
# ─────────────────────────────────────────
.cache/
.temp/
tmp/
.eslintcache
.biomecache

# ─────────────────────────────────────────
# OS artefacts
# ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────
# Editor / IDE settings
# (keep .vscode/extensions.json if you want
#  to recommend extensions to contributors;
#  ignore personal workspace settings)
# ─────────────────────────────────────────
.idea/
*.swp
*.swo
*.swn
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
!.vscode/extensions.json



.rachna/