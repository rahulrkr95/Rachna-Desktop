# Build-time configuration for Rachna IDE (read by Vite; copy to `.env`).
# Every variable is OPTIONAL — the IDE builds and runs without any of them.

# ── Rachna account: "Continue with Google" ─────────────────────────────────
# A Rachna account is only needed for Rachna Cloud AI. Email + password sign-in
# always works; the "Continue with Google" button appears only when this client
# id is set.
#
# Create an OAuth client of type "Desktop app" in Google Cloud Console
# (APIs & Services → Credentials). Google still issues a client secret for
# Desktop clients — it is not confidential, and the sign-in flow also uses PKCE.
#
# IMPORTANT: add the SAME client id to the backend's GOOGLE_CLIENT_IDS
# (comma-separated allow-list), or the backend will reject the Google ID token.
VITE_RACHNA_GOOGLE_CLIENT_ID=
VITE_RACHNA_GOOGLE_CLIENT_SECRET=

# ── Connectors (Gmail / Drive / Calendar, Figma, Slack, Notion) ────────────
# Separate from the account sign-in above. See services/oauth/OAuthProviderRegistry.ts.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_SECRET=
VITE_FIGMA_OAUTH_CLIENT_ID=
VITE_FIGMA_OAUTH_CLIENT_SECRET=
VITE_SLACK_OAUTH_CLIENT_ID=
VITE_SLACK_OAUTH_CLIENT_SECRET=
VITE_NOTION_OAUTH_CLIENT_ID=
VITE_NOTION_OAUTH_CLIENT_SECRET=
